<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Ctrl / Signal, following the phone's dark theme. This is Signal Light (dark icons on a light
      background); values-night/themes.xml is Signal Dark. Compose sets the bars again once running.
    -->
    <style name="Theme.ProxCtrl" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@color/window_bg</item>
        <item name="android:navigationBarColor">@color/window_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
