<?xml version="1.0" encoding="utf-8"?>
<!-- Proxmox VE itself speaks HTTPS (port 8006), but a node can sit behind a reverse proxy that speaks
     plain HTTP on the home network. Server addresses are typed by the user, so cleartext can't be limited
     to a fixed domain here: it stays possible at the platform level, and the app enforces it in code
     (CleartextPolicy.kt): HTTP is only used for a server address the user chose after an "unencrypted
     connection" warning, never for anything else, and an HTTPS request is never downgraded.
     System and user-installed CAs are trusted so servers behind a private CA or Nginx Proxy Manager
     work. A self-signed Proxmox certificate is never trusted here: the app pins the exact certificate
     the user confirmed by its SHA-256 fingerprint, per server, in code (Tls.kt). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
